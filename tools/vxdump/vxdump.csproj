<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vorticity.Tools.VxDump</RootNamespace>
    <AssemblyName>vxdump</AssemblyName>
    <Description>Inspects a Vortex file: schema, layout tree, encodings, segments and statistics.</Description>

    <!-- Application properties, which docs/03-architecture.md §1 says belong here and never on the
         library: InvariantGlobalization has no effect on a class library, and PublishAot is what
         invariant 5 ("a test publishes vxdump as Native AOT and runs it over the corpus") needs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vorticity/Vorticity.csproj" />
  </ItemGroup>

</Project>
