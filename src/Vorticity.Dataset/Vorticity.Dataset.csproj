<Project Sdk="Microsoft.NET.Sdk">

  <!-- Experimental, like Vorticity.RowEncoding and for a related reason: the dataset's format is
       one this repository is the first to write, with decisions still open. The core knows nothing
       of this package; this package references the core, and the row encoding too, which is the
       order a clustering key is kept in. -->
  <PropertyGroup>
    <RootNamespace>Vorticity.Dataset</RootNamespace>
    <AssemblyName>Vorticity.Dataset</AssemblyName>
    <PackageId>Vorticity.Dataset</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);dataset;object-store;versioning</PackageTags>
    <Description>A versioned dataset over an object store: immutable data and commit objects, a prolly tree of leaves, and the store seam an S3 library implements. The format is experimental and this repository is the first to write it.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The core, and the row encoding a clustering key is ordered by: an object's summary holds the
       row-encoded minimum and maximum of its clustering key. The core knows nothing of either. -->
  <ItemGroup>
    <ProjectReference Include="../Vorticity/Vorticity.csproj" />
    <ProjectReference Include="../Vorticity.RowEncoding/Vorticity.RowEncoding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vorticity.Tests" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks.Churn" />
  </ItemGroup>

  <!-- Build-time only, as in the core: the package stays dependency-free at runtime. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
