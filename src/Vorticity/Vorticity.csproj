<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vorticity</RootNamespace>
    <AssemblyName>Vorticity</AssemblyName>
    <PackageId>Vorticity</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);simd;zero-copy;aot</PackageTags>
    <Description>Pure .NET implementation of the Vortex columnar file format, with no third-party dependency.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The two satellites reach into the engine (arenas, the k-way merge, object sources, row
       encoding over decoded nodes) and ship at the same version as the core. vxdump does not: it is
       the proof that the public surface is enough for a tool. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vorticity.RowEncoding" />
    <InternalsVisibleTo Include="Vorticity.Dataset" />
    <InternalsVisibleTo Include="Vorticity.Tests" />
    <InternalsVisibleTo Include="Vorticity.Conformance" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks" />
  </ItemGroup>

  <!-- THE ONE RUNTIME DEPENDENCY, and docs/design/03-architecture.md §1 names it by name: XxHash3-64 for
       the write path's distinct table and the Bloom filters of docs/design/10-indexes.md. It is
       first-party (dotnet/runtime, MIT) but is not carried by the shared framework, so it has to
       be referenced. The alternative was porting it, which would be our own hash to maintain
       against upstream's; the alternative to THAT was keeping FNV-1a byte-at-a-time, which cost
       a fifth to a half of every string column's write. Decided 2026-09-15. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- Compile-time enforcement of the bans in BannedSymbols.txt. Build-time only: PrivateAssets
       keeps these out of the package graph, so nothing THIRD-party ever reaches a consumer, which
       is the claim in Description above. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
