<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vorticity</RootNamespace>
    <AssemblyName>Vorticity</AssemblyName>
    <PackageId>Vorticity</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);simd;zero-copy;aot</PackageTags>
    <Description>Pure .NET implementation of the Vortex columnar file format, with no third-party dependency.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The satellites reach into the engine (arenas, the k-way merge, object sources, row encoding
       over decoded nodes, the scan source a Parquet file plugs into) and ship at the same version as
       the core. vxdump does not: it is the proof that the public surface is enough for a tool. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vorticity.RowEncoding" />
    <InternalsVisibleTo Include="Vorticity.Dataset" />
    <InternalsVisibleTo Include="Vorticity.Parquet" />
    <InternalsVisibleTo Include="Vorticity.Tests" />
    <InternalsVisibleTo Include="Vorticity.Parquet.Tests" />
    <InternalsVisibleTo Include="Vorticity.Conformance" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks.Scenarios" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks.Runner" />
    <InternalsVisibleTo Include="vortex-queries" />
  </ItemGroup>

  <!-- XxHash3-64 for the write path's distinct table and the Bloom filters. It is first-party
       (dotnet/runtime, MIT) but is not carried by the shared framework, so it has to be
       referenced. Porting it would make it our own hash to maintain against upstream's, and FNV-1a
       byte-at-a-time costs a fifth to a half of every string column's write. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- vortex.zstd and vortex.zstd_buffers, read and written by this repository's own zstd rather
       than by the libzstd the runtime ships: managed, so it allocates nothing native and runs
       wherever .NET does, and faster than the runtime's at decompression. -->
  <ItemGroup>
    <ProjectReference Include="../Vorticity.Zstd/Vorticity.Zstd.csproj" />
  </ItemGroup>

  <!-- Compile-time enforcement of the bans in BannedSymbols.txt. Build-time only: PrivateAssets
       keeps these out of the package graph, so nothing THIRD-party ever reaches a consumer, which
       is the claim in Description above. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
