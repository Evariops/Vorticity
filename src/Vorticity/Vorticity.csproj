<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vorticity</RootNamespace>
    <AssemblyName>Vorticity</AssemblyName>
    <Description>Pure .NET, dependency-free implementation of the Vortex columnar file format.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vorticity.Tests" />
    <InternalsVisibleTo Include="Vorticity.Conformance" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks" />
  </ItemGroup>

  <!-- Compile-time enforcement of the bans in BannedSymbols.txt. Build-time only: PrivateAssets
       keeps it out of the package graph, so the library stays dependency-free at runtime, which
       is the claim in Description above. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
