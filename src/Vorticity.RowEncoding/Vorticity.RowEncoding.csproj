<Project Sdk="Microsoft.NET.Sdk">

  <!-- A package of its own, deliberately. docs/09-contracts.md §3: upstream marks the row format
       experimental and reserves the right to change its byte layout between releases. Folding it
       into the core would force a choice between breaking the core's own compatibility promise to
       follow upstream and diverging from Rust, which would cost the byte-exactness that is this
       feature's entire point. The release these keys transcribe is RowEncoder.VortexVersion. -->
  <PropertyGroup>
    <RootNamespace>Vorticity.RowEncoding</RootNamespace>
    <AssemblyName>Vorticity.RowEncoding</AssemblyName>
    <PackageId>Vorticity.RowEncoding</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);row-encoding;byte-sortable;key-encoding</PackageTags>
    <Description>Byte-sortable row encoding for Vortex arrays: columns to row keys whose memcmp order is tuple order. Upstream marks the format experimental and may change its byte layout between releases.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vorticity/Vorticity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vorticity.Tests" />
    <InternalsVisibleTo Include="Vorticity.Benchmarks" />
  </ItemGroup>

  <!-- Compile-time enforcement of the bans in BannedSymbols.txt. Build-time only: PrivateAssets
       keeps it out of the package graph, so the library stays dependency-free at runtime, which
       is the claim in Description above. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
