<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vorticity.Bench.Runner</RootNamespace>
    <AssemblyName>Vorticity.Benchmarks.Runner</AssemblyName>

    <!-- The report's scenarios as a native binary: the process the published page times on our
         side, against the reference's own native binary. It depends on the scenarios and the
         library alone, so that everything in it compiles ahead of time. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishAot>true</PublishAot>

    <!-- Code for the machine it runs on, as the reference is built with -C target-cpu=native: a
         native binary held to the baseline instruction set against one that is not would measure
         the build. -->
    <IlcInstructionSet>native</IlcInstructionSet>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- The native link asks Xcode for its version to choose a linker flag, and a machine with the
         command line tools alone answers with an error the publish then reports. Deciding the flag
         here skips the question. -->
    <UseLdClassicXCodeLinker>false</UseLdClassicXCodeLinker>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vorticity.Benchmarks.Scenarios/Vorticity.Benchmarks.Scenarios.csproj" />
  </ItemGroup>

</Project>
