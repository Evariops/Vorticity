<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vorticity.Conformance</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vorticity/Vorticity.csproj" />
    <ProjectReference Include="../../src/Vorticity.RowEncoding/Vorticity.RowEncoding.csproj" />
  </ItemGroup>

  <!-- The corpus and the forged fixtures live inside this project directory and are found by
       walking up from the source file, never copied: 122 MB into bin/ per configuration is not a
       reasonable build artifact. See CorpusCatalog.FindDirectory. -->
  <ItemGroup>
    <None Remove="corpus/**" />
    <None Remove="forged/**" />
  </ItemGroup>

  <!-- Every test runs beside the others, each row of a theory a test of its own: tests/xunit.runner.json. -->
  <ItemGroup>
    <None Include="../xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
