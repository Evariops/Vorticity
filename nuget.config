<?xml version="1.0" encoding="utf-8"?>
<!-- Every package this repository uses is on nuget.org. Clearing the sources a machine inherits keeps
     central package management's NU1507 (several sources, no mapping) from failing the restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
