<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- The compiler API the generator and the analyzers build against: the oldest compiler they load into. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- The one runtime dependency from Microsoft, first-party: XxHash3-64 for the write path's
         distinct table and the Bloom filters, and the CRC-64/NVME and CRC-32C the object stores
         send, whose parameter sets arrived in 11.0. dotnet/runtime, MIT, not carried by the shared
         framework. It follows the SDK in global.json, a release candidate of .NET 11 until it ships. -->
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0-rc.3.26522.148" />
    <!-- Zstandard and the LZ4 block format in managed C#, Evariops's own, from their own
         repository (github.com/Evariops/ManagedCompressions), released together at one version.
         0.2.0 makes public the prefix decode the reader uses to decode only the start of a frame. -->
    <PackageVersion Include="ManagedCompressions.Zstd" Version="0.2.0" />
    <PackageVersion Include="ManagedCompressions.Lz4" Version="0.2.0" />
  </ItemGroup>
</Project>
